                </mxCell>
                <mxCell id="s-l6" collapsed="1" parent="s-g4" style="swimlane;html=1;whiteSpace=wrap;container=1;collapsible=1;recursiveResize=0;resizeParent=1;resizeParentMax=0;resizeLast=0;startSize=28;fillColor=#f8cecc;swimlaneFillColor=#ffffff;strokeColor=#b85450;fontSize=12;fontStyle=1;align=left;verticalAlign=middle;spacingLeft=8;childLayout=stackLayout;horizontal=1;horizontalStack=0;stackSpacing=6;marginLeft=10;marginRight=10;marginTop=8;marginBottom=10;" value="6. Дымный очаг и тайник в парке (6&amp;times;6) · 6 слов · улика: Полено с секретом" vertex="1">
                    <mxGeometry height="28" width="780" x="2640" y="196" as="geometry">
                        <mxRectangle height="535" width="780" x="2640" y="196" as="alternateBounds"/>
                    </mxGeometry>
                </mxCell>
                <mxCell id="s-l6-box" parent="s-l6" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingRight=8;spacingTop=6;spacingBottom=6;fontSize=11;fontColor=#333333;fillColor=#fafafa;strokeColor=#dddddd;" value="&lt;b&gt;Старт:&lt;/b&gt; Коптилка освещает дымоход. Из парка тянет сыростью, а у большого камня кто-то недавно копал.&lt;br&gt;&lt;br&gt;&lt;b&gt;Финал:&lt;/b&gt; Под камнем в парке тайник. В полене из дымохода спрятаны полусгоревшие бумаги и список векселей. Кто-то прятал то, что не успел сжечь." vertex="1">
                    <mxGeometry height="69" width="760" x="2650" y="232" as="geometry"/>
                </mxCell>
