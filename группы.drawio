                <mxCell id="s-l5-w6-desc" parent="s-l5-w6" style="text;html=1;align=left;verticalAlign=top;fontSize=11;fontColor=#333333;whiteSpace=wrap;" value="Чёрный камень камина, чьи следы на ковре выдают ночного посетителя." vertex="1">
