                <mxCell id="s-l1-w0" collapsed="1" parent="s-l1" style="swimlane;html=1;whiteSpace=wrap;container=1;collapsible=1;recursiveResize=0;resizeParent=1;resizeParentMax=0;resizeLast=0;startSize=24;fillColor=#f5f5f5;swimlaneFillColor=#ffffff;strokeColor=#c0c0c0;fontSize=11;fontStyle=0;align=left;verticalAlign=middle;spacingLeft=8;childLayout=stackLayout;horizontal=1;horizontalStack=0;stackSpacing=0;marginLeft=12;marginRight=12;marginTop=4;marginBottom=8;" value="&lt;b&gt;трубка&lt;/b&gt; — 6 букв" vertex="1">
