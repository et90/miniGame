                </mxCell>
                <mxCell id="s-g4" parent="1" style="swimlane;html=1;whiteSpace=wrap;container=1;collapsible=0;startSize=40;fillColor=#f8cecc;strokeColor=#b85450;fontSize=12;fontStyle=1;verticalAlign=middle;childLayout=stackLayout;horizontal=1;horizontalStack=0;stackSpacing=10;resizeParent=1;resizeParentMax=0;resizeLast=0;marginLeft=20;marginRight=20;marginTop=20;marginBottom=20;" value="Группа 4. Пепелище и сожжённые улики · 3 уровня · конечная ветка" vertex="1">
                    <mxGeometry height="222" width="820" x="2620" y="60" as="geometry"/>
                </mxCell>
                <mxCell id="s-g4-story" collapsed="1" parent="s-g4" style="swimlane;html=1;whiteSpace=wrap;container=1;collapsible=1;recursiveResize=0;resizeParent=1;resizeParentMax=0;resizeLast=0;startSize=28;fillColor=#f8cecc;swimlaneFillColor=#ffffff;strokeColor=#b85450;fontSize=12;fontStyle=1;align=left;verticalAlign=middle;spacingLeft=8;childLayout=stackLayout;horizontal=1;horizontalStack=0;stackSpacing=0;marginLeft=10;marginRight=10;marginTop=8;marginBottom=10;" value="Сюжет группы: вход · выбор · финал" vertex="1">
                    <mxGeometry height="28" width="780" x="2640" y="120" as="geometry">
                        <mxRectangle height="170" width="780" x="2640" y="120" as="alternateBounds"/>
                    </mxGeometry>
                </mxCell>
                <mxCell id="s-g4-story-box" parent="s-g4-story" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingRight=8;spacingTop=6;spacingBottom=6;fontSize=11;fontColor=#333333;fillColor=#fafafa;strokeColor=#dddddd;" value="&lt;b&gt;Вход.&lt;/b&gt; Кто-то жёг бумаги: в доме пахнет гарью, а в печах свежая зола. Пепел хранит больше, чем думает тот, кто его оставил.&lt;br&gt;&lt;br&gt;&lt;b&gt;Выбор.&lt;/b&gt; Три очага расследования: пороховая гарь и ночные записи; дымоход, камин и тайник в парке; печь, топка и всё, что осталось от писем.&lt;br&gt;&lt;br&gt;&lt;b&gt;Финал.&lt;/b&gt; Из пепла и копоти сложена картина: стрельба была подстроена, подлинник завещания сожжён, а часть бумаг спрятана в парке. Виновный боялся не лорда, а его последней воли." vertex="1">
                    <mxGeometry height="124" width="760" x="2650" y="156" as="geometry"/>
                </mxCell>
                <mxCell id="s-l4" collapsed="1" parent="s-g4" style="swimlane;html=1;whiteSpace=wrap;container=1;collapsible=1;recursiveResize=0;resizeParent=1;resizeParentMax=0;resizeLast=0;startSize=28;fillColor=#f8cecc;swimlaneFillColor=#ffffff;strokeColor=#b85450;fontSize=12;fontStyle=1;align=left;verticalAlign=middle;spacingLeft=8;childLayout=stackLayout;horizontal=1;horizontalStack=0;stackSpacing=6;marginLeft=10;marginRight=10;marginTop=8;marginBottom=10;" value="4. Пороховая гарь и ночные записи (5&amp;times;6) · 6 слов · улика: Карандашная запись" vertex="1">
                    <mxGeometry height="28" width="780" x="2640" y="158" as="geometry">
                        <mxRectangle height="535" width="780" x="2640" y="158" as="alternateBounds"/>
                    </mxGeometry>
                </mxCell>
                <mxCell id="s-l4-box" parent="s-l4" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingRight=8;spacingTop=6;spacingBottom=6;fontSize=11;fontColor=#333333;fillColor=#fafafa;strokeColor=#dddddd;" value="&lt;b&gt;Старт:&lt;/b&gt; В гостиной пахнет порохом, в углу тьма, а на ковре дробь. Карандаш лорда лежит там, где он писал.&lt;br&gt;&lt;br&gt;&lt;b&gt;Финал:&lt;/b&gt; Выстрел был отвлекающим: порох и дробь, но ни одной жертвы. Карандаш оставил последнюю строку лорда: «Г. не тот, за кого себя выдаёт. Проверить чай». Но кто такой «Г.»: граф или Грейс?" vertex="1">
                    <mxGeometry height="69" width="760" x="2650" y="194" as="geometry"/>
                </mxCell>
                <mxCell id="s-l4-w0" collapsed="1" parent="s-l4" style="swimlane;html=1;whiteSpace=wrap;container=1;collapsible=1;recursiveResize=0;resizeParent=1;resizeParentMax=0;resizeLast=0;startSize=24;fillColor=#f5f5f5;swimlaneFillColor=#ffffff;strokeColor=#c0c0c0;fontSize=11;fontStyle=0;align=left;verticalAlign=middle;spacingLeft=8;childLayout=stackLayout;horizontal=1;horizontalStack=0;stackSpacing=0;marginLeft=12;marginRight=12;marginTop=4;marginBottom=8;" value="&lt;b&gt;карандаш&lt;/b&gt; — 8 букв" vertex="1">
                    <mxGeometry height="24" width="760" x="2650" y="269" as="geometry">
                        <mxRectangle height="64" width="760" x="2650" y="269" as="alternateBounds"/>
                    </mxGeometry>
                </mxCell>
