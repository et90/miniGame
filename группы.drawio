                <mxCell id="s-l11" collapsed="1" parent="s-g6" style="swimlane;html=1;whiteSpace=wrap;container=1;collapsible=1;recursiveResize=0;resizeParent=1;resizeParentMax=0;resizeLast=0;startSize=28;fillColor=#fff2cc;swimlaneFillColor=#ffffff;strokeColor=#d6b656;fontSize=12;fontStyle=1;align=left;verticalAlign=middle;spacingLeft=8;childLayout=stackLayout;horizontal=1;horizontalStack=0;stackSpacing=6;marginLeft=10;marginRight=10;marginTop=8;marginBottom=10;" value="11. Сладости и мебель с секретом (7&amp;times;8) · 11 слов · улика: Часы с двойным дном" vertex="1">
                    <mxGeometry height="28" width="780" x="920" y="468" as="geometry">
                        <mxRectangle height="885" width="780" x="920" y="468" as="alternateBounds"/>
                    </mxGeometry>
                </mxCell>
                <mxCell id="s-l11-box" parent="s-l11" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingRight=8;spacingTop=6;spacingBottom=6;fontSize=11;fontColor=#333333;fillColor=#fafafa;strokeColor=#dddddd;" value="&lt;b&gt;Старт:&lt;/b&gt; Лорд обожал сладкое. На столе пудинг, шоколад и ириски, а рядом стоят кресло, шкаф и часы.&lt;br&gt;&lt;br&gt;&lt;b&gt;Финал:&lt;/b&gt; В шоколаде и пудинге чувствуется горький привкус, а в часах двойное дно. Там лежит копия нового завещания: всё имущество переходит Грейс." vertex="1">
                    <mxGeometry height="69" width="760" x="930" y="504" as="geometry"/>
                </mxCell>
                <mxCell id="s-l11-w0" collapsed="1" parent="s-l11" style="swimlane;html=1;whiteSpace=wrap;container=1;collapsible=1;recursiveResize=0;resizeParent=1;resizeParentMax=0;resizeLast=0;startSize=24;fillColor=#f5f5f5;swimlaneFillColor=#ffffff;strokeColor=#c0c0c0;fontSize=11;fontStyle=0;align=left;verticalAlign=middle;spacingLeft=8;childLayout=stackLayout;horizontal=1;horizontalStack=0;stackSpacing=0;marginLeft=12;marginRight=12;marginTop=4;marginBottom=8;" value="&lt;b&gt;желе&lt;/b&gt; — 4 буквы" vertex="1">
