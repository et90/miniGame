    <diagram id="story-json" name="сюжет (levels_story.json)">
        <mxGraphModel dx="1430" dy="653" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="3480" pageHeight="664" math="0" shadow="0">
            <root>
                <mxCell id="0"/>
                <mxCell id="1" parent="0"/>
                <mxCell id="s-title" parent="1" style="text;html=1;align=left;verticalAlign=middle;fontSize=16;fontStyle=1;" value="Сюжетная версия (levels_story.json) · уровней: 19" vertex="1">
                    <mxGeometry height="28" width="900" x="40" y="12" as="geometry"/>
                </mxCell>
                <mxCell id="s-g1" parent="1" style="swimlane;html=1;whiteSpace=wrap;container=1;collapsible=0;startSize=40;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;fontStyle=1;verticalAlign=middle;childLayout=stackLayout;horizontal=1;horizontalStack=0;stackSpacing=10;resizeParent=1;resizeParentMax=0;resizeLast=0;marginLeft=20;marginRight=20;marginTop=20;marginBottom=20;" value="Группа 1. Снаряжение для слежки и выезда · 3 уровня · открывает: 2, 3" vertex="1">
                    <mxGeometry height="222" width="820" x="40" y="60" as="geometry"/>
                </mxCell>
                <mxCell id="s-g1-story" collapsed="1" parent="s-g1" style="swimlane;html=1;whiteSpace=wrap;container=1;collapsible=1;recursiveResize=0;resizeParent=1;resizeParentMax=0;resizeLast=0;startSize=28;fillColor=#dae8fc;swimlaneFillColor=#ffffff;strokeColor=#6c8ebf;fontSize=12;fontStyle=1;align=left;verticalAlign=middle;spacingLeft=8;childLayout=stackLayout;horizontal=1;horizontalStack=0;stackSpacing=0;marginLeft=10;marginRight=10;marginTop=8;marginBottom=10;" value="Сюжет группы: вход · выбор · финал" vertex="1">
                    <mxGeometry height="28" width="780" x="20" y="60" as="geometry">
                        <mxRectangle height="184" width="780" x="20" y="60" as="alternateBounds"/>
                    </mxGeometry>
                </mxCell>
                <mxCell id="s-g1-story-box" parent="s-g1-story" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingRight=8;spacingTop=6;spacingBottom=6;fontSize=11;fontColor=#333333;fillColor=#fafafa;strokeColor=#dddddd;" value="&lt;b&gt;Вход.&lt;/b&gt; Ноябрьский вечер. На пороге вашей конторы на Бейкер-стрит стоит мальчишка с телеграммой от дворецкого Пибоди: «Лорд Эдмунд Рейвенхолл найден мёртвым в господском зале посреди раута. На шее шнур, но доктор сомневается. В доме все лгут. Приезжайте немедленно». Саквояж, плащ, лупа — и в путь.&lt;br&gt;&lt;br&gt;&lt;b&gt;Выбор.&lt;/b&gt; Что сделать до отъезда: подготовить маскировку, изучить дорогу к поместью или разобрать по телеграмме загадку шнура и узлов? Все три дела нужно закончить, прежде чем карета тронется.&lt;br&gt;&lt;br&gt;&lt;b&gt;Финал.&lt;/b&gt; Саквояж собран, дорога известна, узел разгадан. Карета ждёт у подъезда. В поместье Рейвенхолл-Холл вас ждут две нити расследования: люди, что были в доме, и сам дом ночью. С какой начать, решать вам." vertex="1">
                    <mxGeometry height="138" width="760" x="10" y="36" as="geometry"/>
                </mxCell>
                <mxCell id="s-l0" collapsed="1" parent="s-g1" style="swimlane;html=1;whiteSpace=wrap;container=1;collapsible=1;recursiveResize=0;resizeParent=1;resizeParentMax=0;resizeLast=0;startSize=28;fillColor=#dae8fc;swimlaneFillColor=#ffffff;strokeColor=#6c8ebf;fontSize=12;fontStyle=1;align=left;verticalAlign=middle;spacingLeft=8;childLayout=stackLayout;horizontal=1;horizontalStack=0;stackSpacing=6;marginLeft=10;marginRight=10;marginTop=8;marginBottom=10;" value="0. Маскировка и тайные знаки (4&amp;times;4) · 4 слова · улика: Шифрованный листок" vertex="1">
                    <mxGeometry height="28" width="780" x="20" y="98" as="geometry">
                        <mxRectangle height="409" width="780" x="60" y="158" as="alternateBounds"/>
                    </mxGeometry>
                </mxCell>
                <mxCell id="s-l0-box" parent="s-l0" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingRight=8;spacingTop=6;spacingBottom=6;fontSize=11;fontColor=#333333;fillColor=#fafafa;strokeColor=#dddddd;" value="&lt;b&gt;Старт:&lt;/b&gt; Вы надеваете фрак для приёма и плащ для дождя, лупа лежит в кармане. Сегодня в доме Рейвенхолла вы никому не известный гость, который всё видит.&lt;br&gt;&lt;br&gt;&lt;b&gt;Финал:&lt;/b&gt; Лупа находит в кармане лорда шифрованный листок: «В полночь у камня в парке. Принеси вексель». Лорд назначил кому-то встречу и не дожил до неё." vertex="1">
                    <mxGeometry height="83" width="760" x="70" y="194" as="geometry"/>
                </mxCell>
                <mxCell id="s-l0-w0" collapsed="1" parent="s-l0" style="swimlane;html=1;whiteSpace=wrap;container=1;collapsible=1;recursiveResize=0;resizeParent=1;resizeParentMax=0;resizeLast=0;startSize=24;fillColor=#f5f5f5;swimlaneFillColor=#ffffff;strokeColor=#c0c0c0;fontSize=11;fontStyle=0;align=left;verticalAlign=middle;spacingLeft=8;childLayout=stackLayout;horizontal=1;horizontalStack=0;stackSpacing=0;marginLeft=12;marginRight=12;marginTop=4;marginBottom=8;" value="&lt;b&gt;лупа&lt;/b&gt; — 4 буквы" vertex="1">
