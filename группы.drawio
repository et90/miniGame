                    </mxGeometry>
                </mxCell>
                <mxCell id="s-l3-w4-desc" parent="s-l3-w4" style="text;html=1;align=left;verticalAlign=top;fontSize=11;fontColor=#333333;whiteSpace=wrap;" value="Сушёное золото курильщика, чей аромат выдаёт привычки хозяина мгновенно." vertex="1">
                    <mxGeometry height="28" width="736" x="1802" y="577" as="geometry"/>
                </mxCell>
                <mxCell id="s-l5" collapsed="1" parent="s-g3" style="swimlane;html=1;whiteSpace=wrap;container=1;collapsible=1;recursiveResize=0;resizeParent=1;resizeParentMax=0;resizeLast=0;startSize=28;fillColor=#ffe6cc;swimlaneFillColor=#ffffff;strokeColor=#d79b00;fontSize=12;fontStyle=1;align=left;verticalAlign=middle;spacingLeft=8;childLayout=stackLayout;horizontal=1;horizontalStack=0;stackSpacing=6;marginLeft=10;marginRight=10;marginTop=8;marginBottom=10;" value="5. Огни во мгле и пыль следов (5&amp;times;7) · 7 слов · улика: Свеча-поджигатель" vertex="1">
                    <mxGeometry height="28" width="780" x="1780" y="196" as="geometry">
                        <mxRectangle height="605" width="780" x="1780" y="196" as="alternateBounds"/>
                    </mxGeometry>
                </mxCell>
                <mxCell id="s-l5-box" parent="s-l5" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingRight=8;spacingTop=6;spacingBottom=6;fontSize=11;fontColor=#333333;fillColor=#fafafa;strokeColor=#dddddd;" value="&lt;b&gt;Старт:&lt;/b&gt; Факел в руке, мгла за окном. В подвале сыро, а пыль хранит чужие шаги.&lt;br&gt;&lt;br&gt;&lt;b&gt;Финал:&lt;/b&gt; Свеча с длинным фитилём оказалась замедленным поджогом. Угольная крошка на ковре и два следа в пыли, один с хромотой, выдают ночных гостей. Огонь должен был вспыхнуть, когда виновный будет на людях." vertex="1">
                    <mxGeometry height="69" width="760" x="1790" y="232" as="geometry"/>
                </mxCell>
                <mxCell id="s-l5-w0" collapsed="1" parent="s-l5" style="swimlane;html=1;whiteSpace=wrap;container=1;collapsible=1;recursiveResize=0;resizeParent=1;resizeParentMax=0;resizeLast=0;startSize=24;fillColor=#f5f5f5;swimlaneFillColor=#ffffff;strokeColor=#c0c0c0;fontSize=11;fontStyle=0;align=left;verticalAlign=middle;spacingLeft=8;childLayout=stackLayout;horizontal=1;horizontalStack=0;stackSpacing=0;marginLeft=12;marginRight=12;marginTop=4;marginBottom=8;" value="&lt;b&gt;свеча&lt;/b&gt; — 5 букв" vertex="1">
